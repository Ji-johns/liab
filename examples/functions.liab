// ============================================================
// LIAB v0.2 — Feature Showcase
// ============================================================
// This program demonstrates all new v0.2 features:
//   - Function definitions and calls
//   - Return statements
//   - If/else conditionals
//   - While loops
//   - Boolean values
//   - Comparison operators
//   - Variable scoping
// ============================================================

// --- Function definition ---
fn add(a, b) {
    return a + b;
}

fn max(a, b) {
    if a > b {
        return a;
    } else {
        return b;
    }
}

fn factorial(n) {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

// --- Function calls ---
let sum = add(10, 20);
print sum;

let bigger = max(42, 17);
print bigger;

// --- Factorial (recursion) ---
let fact5 = factorial(5);
print fact5;

// --- While loop ---
let counter = 0;
while counter < 5 {
    counter = counter + 1;
}
print counter;

// --- Booleans and comparisons ---
let is_big = 100 > 50;
print is_big;

let is_equal = 7 == 7;
print is_equal;

// --- If/else ---
let x = 15;
if x >= 10 {
    print x;
} else {
    print 0;
}

// --- Nested scope ---
let outer = 1;
{
    let inner = 2;
    print inner;
}
// `inner` is no longer accessible here
print outer;
