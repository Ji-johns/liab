fn square(x) {
    return x * x;
}

fn cube(x) {
    return x * x * x;
}

fn factorial(n) {
    if n == 0 {
        return 1;
    }
    return n * factorial(n - 1);
}

fn fibonacci(n) {
    if n <= 1 {
        return n;
    }
    return fibonacci(n - 1) + fibonacci(n - 2);
}

export square;
export cube;
export factorial;
export fibonacci;
